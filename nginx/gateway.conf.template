proxy_cache_path /var/cache/nginx/gateway levels=1:2 keys_zone=gateway:16m max_size=512m inactive=${CACHE_TTL} use_temp_path=off;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

map $uri $cache_skip_uri {
    default                 0;
    ~^/api/auth/            1;
    ~^/api/social/callback/ 1;
    ~^/api/tech/            1;
    ~^/api/actuator/        1;
    ~^/healthz$             1;
}

server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;

    client_max_body_size 20m;

    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    proxy_cache gateway;
    proxy_cache_key $scheme$proxy_host$request_uri;
    proxy_cache_valid 200 301 302 ${CACHE_TTL};
    proxy_cache_lock on;
    proxy_cache_bypass $http_authorization $cache_skip_uri;
    proxy_no_cache $http_authorization $cache_skip_uri;
    proxy_ignore_headers Cache-Control Expires;
    add_header X-Cache-Status $upstream_cache_status always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    location /api/ {
        proxy_pass ${BACKEND_URL};
    }

    location /v3/api-docs {
        proxy_pass ${BACKEND_URL};
    }

    location /swagger-ui {
        proxy_pass ${BACKEND_URL};
    }

    location / {
        proxy_pass ${FRONTEND_URL};
    }
}
