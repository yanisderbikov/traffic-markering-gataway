# Куда проксировать /api/**, /v3/api-docs и /swagger-ui (бэкенд).
# Локально бэк из docker-compose бэкенда слушает 8090 на хосте.
# На Railway: BACKEND_URL=http://traffic-markering-back.railway.internal:8090
BACKEND_URL=http://host.docker.internal:8090

# Куда проксировать всё остальное (фронтенд).
# Локально это vite-дев-сервер на 3000 или контейнер фронта.
# На Railway: FRONTEND_URL=http://traffic-markering-front.railway.internal:80
FRONTEND_URL=http://host.docker.internal:3000

# Порт, на котором слушает сам гейтвей внутри контейнера.
# Railway и подобные платформы подставляют свой PORT сами.
PORT=80
